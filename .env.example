# ─── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# ─── Resend Email (optional — skipped if not set) ─────────────────────────────
# Get at resend.com (free tier: 100 emails/day)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=TourFlow <noreply@yourdomain.com>

# ─── App URL ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# ─── Cron Job Protection ───────────────────────────────────────────────────────
CRON_SECRET=your-random-secret-string

# ─── Telegram Bot (optional — skipped if not set) ─────────────────────────────
# 1. Create a bot at t.me/BotFather → /newbot
# 2. Copy the token below
# 3. Register the webhook (once after deploy):
#    curl -X POST "https://api.telegram.org/bot<TOKEN>/setWebhook" \
#      -d url=https://your-app.vercel.app/api/telegram/webhook \
#      -d secret_token=<TELEGRAM_WEBHOOK_SECRET>
TELEGRAM_BOT_TOKEN=123456789:your-bot-token
TELEGRAM_BOT_USERNAME=TourFlowBot
TELEGRAM_WEBHOOK_SECRET=your-random-webhook-secret

# ─── Public contact (shown on /privacy and /terms) ─────────────────────────────
NEXT_PUBLIC_CONTACT_EMAIL=info@yourdomain.com
