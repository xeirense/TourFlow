# ============================================================
#  TourFlow – Environment Variables
#  Copy this file to .env.local and fill in your values
# ============================================================

# ── Database mode ─────────────────────────────────────────────────────────────
# "true"  → local file-based mock (no Supabase, data in .mock-offers.json)
# "false" → Supabase (fill in keys below)
USE_MOCK_DB=true

# ── Supabase (required when USE_MOCK_DB=false) ────────────────────────────────
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key – server-side only, bypasses RLS (used for INSERT)
# Supabase Dashboard → Project Settings → API → service_role (secret)
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Manager panel PIN ─────────────────────────────────────────────────────────
# Default: 1234 — CHANGE THIS before going live!
NEXT_PUBLIC_CREATE_PIN=1234

# ── API secret (optional but recommended for production) ──────────────────────
# Prevents strangers from directly calling POST /api/offers
# Set the SAME value in both API_SECRET and NEXT_PUBLIC_API_SECRET
API_SECRET=change-me-to-a-random-string
NEXT_PUBLIC_API_SECRET=change-me-to-a-random-string

# ── App URL (optional) ────────────────────────────────────────────────────────
# NEXT_PUBLIC_APP_URL=https://yourdomain.com
