# ============================================================
#  TourFlow – Environment Variables
#  Copy this file to .env.local and fill in your values
# ============================================================

# ── Database mode ─────────────────────────────────────────────────────────────
# "true"  → local file-based mock (no Supabase, data in .mock-offers.json)
# "false" → Supabase (fill in keys below)
USE_MOCK_DB=true

# ── Supabase (required when USE_MOCK_DB=false) ────────────────────────────────
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key – server-side only, bypasses RLS (used for INSERT)
# Supabase Dashboard → Project Settings → API → service_role (secret)
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Manager panel PIN ─────────────────────────────────────────────────────────
# Default: 1234 — CHANGE THIS before going live!
NEXT_PUBLIC_CREATE_PIN=1234

# ── API secret (optional but recommended for production) ──────────────────────
# Prevents strangers from directly calling POST /api/offers
# Set the SAME value in both API_SECRET and NEXT_PUBLIC_API_SECRET
API_SECRET=change-me-to-a-random-string
NEXT_PUBLIC_API_SECRET=change-me-to-a-random-string

# ── App URL (optional) ────────────────────────────────────────────────────────
# If set, used as the base URL for shareable offer links in the dashboard.
# If not set, the app auto-detects the domain from the request Host header.
# NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# ── Email notifications via Resend (optional) ─────────────────────────────────
# Get your API key at: https://resend.com (free tier: 100 emails/day)
# If not set, notifications are silently skipped.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# Sender address — requires domain verification in Resend dashboard.
# Without domain verification, use the default (Resend shared test domain).
# RESEND_FROM_EMAIL=TourFlow <noreply@yourdomain.com>
